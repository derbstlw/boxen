---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Kontakt">
  <section class="section">
    <div class="container">
      <p class="text-uppercase fw-bold text-danger">Kontakt</p>
      <h1 class="section-title">Kontaktinformationen</h1>
      <div class="row g-4">
        <div class="col-lg-6">
          <div class="notice mb-4"><strong>Keine Kontaktdaten angenommen.</strong><br />Für dieses MVP sind keine E-Mail-Adresse, Telefonnummer oder Postanschrift verifiziert.</div>
          <h2 class="h4">Postadresse / Standort</h2>
          <address>
            Olympia-Halle Elmshorn<br />
            Pestalozzistr. 2<br />
            25335 Elmshorn
          </address>
        </div>
        <div class="col-lg-6">
          <h2 class="h4">Vom Verein zu liefern</h2>
          <ul>
            <li><span class="placeholder">[E-Mail-Adresse]</span></li>
            <li><span class="placeholder">[Telefonnummer]</span></li>
            <li><span class="placeholder">[Kontaktperson / Zuständigkeit]</span></li>
            <li><span class="placeholder">[Vereinsanschrift, falls öffentlich gewünscht]</span></li>
            <li><span class="placeholder">[Anmeldeschritte und Probetraining]</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
