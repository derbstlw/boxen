---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteUrl } from '../utils/site-url';
---
<BaseLayout title="Trainingszeiten">
  <section class="section">
    <div class="container">
      <p class="text-uppercase fw-bold text-danger">Training</p>
      <h1 class="section-title">Trainingszeiten</h1>
      <div class="notice mb-4" role="note">
        <strong>Hinweis:</strong> Die Angaben basieren auf einem öffentlichen Trainingsplan vom 3. Dezember 2025. Die Uhrzeiten und das aktuelle Angebot sind <strong>nicht bestätigt</strong> und können sich geändert haben.
      </div>
      <h2 class="h4">Standort</h2>
      <address class="mb-4">
        Olympia-Halle Elmshorn<br />
        Pestalozzistr. 2<br />
        25335 Elmshorn
      </address>
      <h2 class="h4">Öffentlicher Trainingsplan – Entwurf</h2>
      <div class="table-responsive">
        <table class="table table-striped mb-0">
          <thead><tr><th scope="col">Tag</th><th scope="col">Uhrzeit</th><th scope="col">Angebot</th><th scope="col">Hinweis</th></tr></thead>
          <tbody>
            <tr><th scope="row">Dienstag</th><td class="placeholder">[Uhrzeit ergänzen]</td><td>Kinder</td><td class="placeholder">[Altersgruppe und Voraussetzung bestätigen]</td></tr>
            <tr><th scope="row">Dienstag</th><td class="placeholder">[Uhrzeit ergänzen]</td><td>Ältere Teilnehmende / Fortgeschrittene</td><td class="placeholder">[genaue Bezeichnung bestätigen]</td></tr>
            <tr><th scope="row">Donnerstag</th><td class="placeholder">[Uhrzeit ergänzen]</td><td>Kinder</td><td class="placeholder">[Altersgruppe bestätigen]</td></tr>
            <tr><th scope="row">Donnerstag</th><td class="placeholder">[Uhrzeit ergänzen]</td><td>Fitness-Boxen</td><td class="placeholder">[Uhrzeit und Teilnahmebestimmungen bestätigen]</td></tr>
          </tbody>
        </table>
      </div>
      <p class="mt-3">Bitte melden Sie sich <a href={siteUrl('kontakt/')}>über den vereinbarten Kontaktweg</a>, sobald aktuelle Kontaktdaten hinterlegt sind.</p>
    </div>
  </section>
</BaseLayout>
